{
  "boundary": {
    "architectures": [
      "amd64",
      "arm64"
    ],
    "cross_architecture_behavior": "identical except DPKG_MAINTSCRIPT_ARCH; all seven pinned config facts are identical",
    "excluded_frontends": [
      "apt",
      "apt-get",
      "debconf",
      "dpkg-preconfigure"
    ],
    "invocation": "direct-dpkg-only",
    "limits": {
      "maximum_argument_bytes": 256,
      "maximum_arguments": 16,
      "maximum_control_bytes": 262144,
      "maximum_control_members": 16,
      "maximum_environment_line_bytes": 4096,
      "maximum_environment_records": 128,
      "maximum_environment_variables": 32,
      "maximum_file_bytes": 262144,
      "maximum_log_bytes": 131072,
      "maximum_packages": 16,
      "maximum_status_bytes": 262144,
      "maximum_trace_bytes": 131072,
      "maximum_trace_records": 128,
      "maximum_updates": 32,
      "pause_script_timeout_seconds": 30,
      "pause_timeout_seconds": 10,
      "subprocess_timeout_seconds": 60
    },
    "operations": [
      "install",
      "reinstall",
      "upgrade",
      "configure",
      "remove",
      "purge",
      "interrupted-retry"
    ]
  },
  "implementation_requirement": {
    "current_native_guards": "unchanged: installed config remains opaque package metadata and incoming config still causes pre-mutation unsupported-archive-metadata handoff",
    "required_behavior": "A future native implementation must retain config as executable-mode, byte-exact, non-lifecycle package metadata; stage incoming bytes for preinst, keep installed bytes visible through old prerm/preinst/postrm, publish incoming bytes before new postinst, remove them only after successful postrm remove settlement, keep or restore them on failed or interrupted removal and failed upgrade rollback, leave them absent for postrm purge, and never execute them in the direct-dpkg lifecycle. Any debconf or preconfiguration execution belongs to a separately specified frontend.",
    "support_status": "reference-only-not-enabled"
  },
