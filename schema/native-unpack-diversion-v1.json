{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://debz.dev/schema/native-unpack-diversion-v1",
  "title": "Native unpack diversion input v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "intent_sha256",
    "program_step",
    "cache_json",
    "digest_sha256"
  ],
  "properties": {
    "schema": {
      "const": "https://debz.dev/schema/native-unpack-diversion-v1"
    },
    "version": {
      "const": 1
    },
    "intent_sha256": {
      "$ref": "#/$defs/digest"
    },
    "program_step": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "cache_json": {
      "type": "string",
      "maxLength": 89482584,
      "contentMediaType": "application/json",
      "contentSchema": {
        "$ref": "https://debz.dev/schema/native-diversion-cache-v1"
      }
    },
    "backups": {
      "description": "Original ordinary-file backup inputs. Omission preserves the pre-backup execution protocol.",
      "type": "array",
      "maxItems": 200000,
      "items": {
        "$ref": "#/$defs/backup"
      }
    },
    "digest_sha256": {
      "$ref": "#/$defs/digest"
    },
    "deferred_removals": {
      "description": "Bind payload-first obsolete-removal ordering. Omission preserves the original lowering order.",
      "const": true
    },
    "settlement": {
      "description": "Immutable late intents; presence selects a separate post-payload settlement journal.",
      "$ref": "#/$defs/settlement"
    }
  },
  "dependentRequired": {
    "deferred_removals": ["backups"],
    "settlement": ["backups", "deferred_removals"]
  },
  "$defs": {
    "settlement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version", "unpack_plan_sha256", "base_generation_sha256",
        "base_generation_file_count", "base_generation_total_bytes",
        "base_status_sha256", "base_status_size", "base_status_package_count",
        "resulting_status_sha256", "resulting_status_size",
        "resulting_status_package_count", "database_plan_sha256", "writes"
      ],
      "properties": {
        "version": { "const": 1 },
        "unpack_plan_sha256": { "$ref": "#/$defs/digest" },
        "base_generation_sha256": { "$ref": "#/$defs/digest" },
        "base_generation_file_count": { "$ref": "#/$defs/unsigned" },
        "base_generation_total_bytes": { "$ref": "#/$defs/unsigned" },
        "base_status_sha256": { "$ref": "#/$defs/digest" },
        "base_status_size": { "$ref": "#/$defs/unsigned" },
        "base_status_package_count": { "$ref": "#/$defs/unsigned" },
        "resulting_status_sha256": { "$ref": "#/$defs/digest" },
        "resulting_status_size": { "$ref": "#/$defs/unsigned" },
        "resulting_status_package_count": { "$ref": "#/$defs/unsigned" },
        "database_plan_sha256": { "$ref": "#/$defs/digest" },
        "writes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200000,
          "items": { "$ref": "#/$defs/settlementWrite" }
        }
      }
    },
    "settlementWrite": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "file": { "$ref": "#/$defs/settlementFile" },
        "metadata": { "$ref": "#/$defs/settlementMetadata" },
        "remove": { "$ref": "#/$defs/settlementRemoval" },
        "remove_directory": { "$ref": "#/$defs/settlementRemoval" }
      }
    },
    "settlementFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path", "bytes_hex", "sha256", "mode", "uid", "gid",
        "modified_nanoseconds", "overwrite"
      ],
      "properties": {
        "path": { "$ref": "#/$defs/path", "pattern": "^var/lib/dpkg/" },
        "bytes_hex": { "type": "string", "maxLength": 134217728, "pattern": "^(?:[0-9a-f]{2})*$" },
        "sha256": { "$ref": "#/$defs/digest" },
        "mode": { "type": "integer", "minimum": 0, "maximum": 4095 },
        "uid": { "$ref": "#/$defs/owner" },
        "gid": { "$ref": "#/$defs/owner" },
        "modified_nanoseconds": { "$ref": "#/$defs/timestamp" },
        "overwrite": { "enum": ["replace", "require_absent"] }
      }
    },
    "settlementMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "minProperties": 2,
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "mode": { "type": "integer", "minimum": 0, "maximum": 4095 },
        "uid": { "$ref": "#/$defs/owner" },
        "gid": { "$ref": "#/$defs/owner" },
        "modified_nanoseconds": { "$ref": "#/$defs/timestamp" }
      }
    },
    "settlementRemoval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "removal"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "removal": { "enum": ["require_present", "allow_absent"] }
      }
    },
    "backup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path", "logical_path", "kind", "mode", "uid", "gid", "size",
        "device", "inode", "modified_nanoseconds", "backup_modified_nanoseconds"
      ],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "logical_path": { "$ref": "#/$defs/path" },
        "kind": { "enum": ["regular", "symlink"] },
        "mode": { "type": "integer", "minimum": 0, "maximum": 4095 },
        "uid": { "$ref": "#/$defs/owner" },
        "gid": { "$ref": "#/$defs/owner" },
        "size": { "$ref": "#/$defs/unsigned" },
        "device": { "$ref": "#/$defs/unsigned" },
        "inode": { "type": "integer", "minimum": 1, "maximum": 18446744073709551615 },
        "modified_nanoseconds": { "$ref": "#/$defs/timestamp" },
        "backup_modified_nanoseconds": { "$ref": "#/$defs/timestamp" },
        "content_sha256": { "$ref": "#/$defs/digest" },
        "link_target": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[^\\u0000-\\u001f\\u007f]+$" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "regular" } } },
          "then": { "required": ["content_sha256"], "not": { "required": ["link_target"] } },
          "else": {
            "required": ["link_target"],
            "properties": { "mode": { "const": 511 } },
            "not": { "required": ["content_sha256"] }
          }
        }
      ]
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^/\\u0000-\\u001f\\u007f][^\\u0000-\\u001f\\u007f]*$"
    },
    "owner": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "unsigned": { "type": "integer", "minimum": 0, "maximum": 18446744073709551615 },
    "timestamp": {
      "type": "integer",
      "minimum": -39614081257132168796771975168,
      "maximum": 39614081257132168796771975167
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
