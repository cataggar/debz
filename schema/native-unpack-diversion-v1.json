{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://debz.dev/schema/native-unpack-diversion-v1",
  "title": "Native unpack diversion input v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "intent_sha256",
    "program_step",
    "cache_json",
    "digest_sha256"
  ],
  "properties": {
    "schema": {
      "const": "https://debz.dev/schema/native-unpack-diversion-v1"
    },
    "version": {
      "const": 1
    },
    "intent_sha256": {
      "$ref": "#/$defs/digest"
    },
    "program_step": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "cache_json": {
      "type": "string",
      "maxLength": 89482584,
      "contentMediaType": "application/json",
      "contentSchema": {
        "$ref": "https://debz.dev/schema/native-diversion-cache-v1"
      }
    },
    "backups": {
      "description": "Original ordinary-file backup inputs. Omission preserves the pre-backup execution protocol.",
      "type": "array",
      "maxItems": 200000,
      "items": {
        "$ref": "#/$defs/backup"
      }
    },
    "digest_sha256": {
      "$ref": "#/$defs/digest"
    },
    "deferred_removals": {
      "description": "Bind payload-first obsolete-removal ordering. Omission preserves the original lowering order.",
      "const": true
    }
  },
  "dependentRequired": {
    "deferred_removals": ["backups"]
  },
  "$defs": {
    "backup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path", "logical_path", "kind", "mode", "uid", "gid", "size",
        "device", "inode", "modified_nanoseconds", "backup_modified_nanoseconds"
      ],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "logical_path": { "$ref": "#/$defs/path" },
        "kind": { "enum": ["regular", "symlink"] },
        "mode": { "type": "integer", "minimum": 0, "maximum": 4095 },
        "uid": { "$ref": "#/$defs/owner" },
        "gid": { "$ref": "#/$defs/owner" },
        "size": { "$ref": "#/$defs/unsigned" },
        "device": { "$ref": "#/$defs/unsigned" },
        "inode": { "type": "integer", "minimum": 1, "maximum": 18446744073709551615 },
        "modified_nanoseconds": { "$ref": "#/$defs/timestamp" },
        "backup_modified_nanoseconds": { "$ref": "#/$defs/timestamp" },
        "content_sha256": { "$ref": "#/$defs/digest" },
        "link_target": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[^\\u0000-\\u001f\\u007f]+$" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "regular" } } },
          "then": { "required": ["content_sha256"], "not": { "required": ["link_target"] } },
          "else": {
            "required": ["link_target"],
            "properties": { "mode": { "const": 511 } },
            "not": { "required": ["content_sha256"] }
          }
        }
      ]
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^/\\u0000-\\u001f\\u007f][^\\u0000-\\u001f\\u007f]*$"
    },
    "owner": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "unsigned": { "type": "integer", "minimum": 0, "maximum": 18446744073709551615 },
    "timestamp": {
      "type": "integer",
      "minimum": -39614081257132168796771975168,
      "maximum": 39614081257132168796771975167
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
