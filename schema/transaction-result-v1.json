{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://debz.dev/schema/transaction-result-v1",
  "title": "debz transaction result and provenance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "version", "target_architecture", "request_sha256",
    "solver_policy_sha256", "executor_policy_sha256", "plan_sha256",
    "lock_sha256", "repositories", "packages", "commands", "journal_steps",
    "recovery_steps", "final_verification", "outcome", "diagnostic",
    "digest_sha256"
  ],
  "properties": {
    "schema": { "const": "https://debz.dev/schema/transaction-result-v1" },
    "version": { "const": 1 },
    "target_architecture": { "type": "string", "minLength": 1 },
    "request_sha256": { "$ref": "#/$defs/sha256" },
    "solver_policy_sha256": { "$ref": "#/$defs/sha256" },
    "executor_policy_sha256": { "$ref": "#/$defs/sha256" },
    "plan_sha256": { "$ref": "#/$defs/sha256" },
    "lock_sha256": { "$ref": "#/$defs/sha256" },
    "repositories": {
      "type": "array",
      "items": { "$ref": "#/$defs/repository" }
    },
    "packages": {
      "type": "array",
      "items": { "$ref": "#/$defs/package" }
    },
    "commands": {
      "type": "array",
      "items": { "$ref": "#/$defs/command" }
    },
    "journal_steps": {
      "type": "array",
      "items": { "$ref": "#/$defs/journalStep" }
    },
    "recovery_steps": {
      "type": "array",
      "items": { "$ref": "#/$defs/journalStep" }
    },
    "final_verification": { "$ref": "#/$defs/finalVerification" },
    "outcome": { "enum": ["succeeded", "failed", "interrupted", "recovery_required"] },
    "diagnostic": { "type": "string" },
    "digest_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_config_id", "snapshot_sha256", "release_sha256", "signature_sha256", "metadata_sha256", "signer_fingerprints", "signature_verified"],
      "properties": {
        "source_config_id": { "$ref": "#/$defs/sha256" },
        "snapshot_sha256": { "$ref": "#/$defs/sha256" },
        "release_sha256": { "$ref": "#/$defs/sha256" },
        "signature_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "metadata_sha256": { "$ref": "#/$defs/sha256" },
        "signer_fingerprints": { "type": "array", "items": { "$ref": "#/$defs/fingerprint" } },
        "signature_verified": { "const": true }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "architecture", "repository_id", "repository_snapshot_sha256", "package_sha256", "cas_sha256", "declared_size"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "architecture": { "type": "string", "minLength": 1 },
        "repository_id": { "$ref": "#/$defs/sha256" },
        "repository_snapshot_sha256": { "$ref": "#/$defs/sha256" },
        "package_sha256": { "$ref": "#/$defs/sha256" },
        "cas_sha256": { "$ref": "#/$defs/sha256" },
        "declared_size": { "type": "integer", "minimum": 0 }
      }
    },
    "environmentEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "value"],
      "properties": {
        "key": { "type": "string" },
        "value": { "type": "string" }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "package", "argv", "environment", "command_sha256", "artifact_sha256"],
      "properties": {
        "phase": { "type": "string", "minLength": 1 },
        "package": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "argv": { "type": "array", "items": { "type": "string" } },
        "environment": { "type": "array", "items": { "$ref": "#/$defs/environmentEntry" } },
        "command_sha256": { "$ref": "#/$defs/sha256" },
        "artifact_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] }
      }
    },
    "journalStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "boundary", "state", "command_index", "recovered"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 0 },
        "boundary": { "type": "string", "minLength": 1 },
        "state": { "type": "string", "minLength": 1 },
        "command_index": { "type": "integer", "minimum": 0 },
        "recovered": { "type": "boolean" }
      }
    },
    "finalVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "installed_state_sha256", "package_origins_sha256", "detail"],
      "properties": {
        "status": { "enum": ["exact_match", "mismatch", "not_run"] },
        "installed_state_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "package_origins_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "detail": { "type": "string" }
      }
    }
  }
}
