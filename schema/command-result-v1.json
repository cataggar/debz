{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cataggar/debz/schema/command-result-v1.json",
  "title": "debz command result v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema", "api_version", "operation", "exit_status", "changed", "summary", "items", "diagnostics"],
  "properties": {
    "schema": { "const": "io.github.cataggar.debz.command.v1" },
    "api_version": { "const": 1 },
    "operation": {
      "enum": ["refresh", "install", "remove", "upgrade", "upgrade-all", "reinstall", "download", "plan", "list-installed", "list-available", "info", "provides", "why", "clean", "recover"]
    },
    "exit_status": { "enum": [0, 2, 3, 4, 5, 6, 7, 8, 70] },
    "changed": { "type": "boolean" },
    "summary": { "type": "string" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["package", "version", "architecture", "detail"],
        "properties": {
          "package": { "type": "string" },
          "version": { "type": ["string", "null"] },
          "architecture": { "type": ["string", "null"] },
          "detail": { "type": ["string", "null"] },
          "repository": { "$ref": "#/$defs/repository" }
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "message"],
        "properties": {
          "id": { "type": "string" },
          "message": { "type": "string" }
        }
      }
    }
  },
  "allOf": [{
    "if": { "properties": { "operation": { "const": "refresh" } } },
    "else": {
      "properties": { "items": { "items": { "not": { "required": ["repository"] } } } }
    }
  }],
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release_digest", "signer_fingerprints", "snapshot_digest", "frozen"],
      "properties": {
        "release_digest": { "$ref": "#/$defs/digest" },
        "snapshot_digest": { "$ref": "#/$defs/digest" },
        "signer_fingerprints": {
          "type": "array", "uniqueItems": true,
          "items": { "$ref": "#/$defs/fingerprint" }
        },
        "frozen": {
          "oneOf": [{ "type": "null" }, {
            "type": "object",
            "additionalProperties": false,
            "required": ["release_digest", "admission_deadline_unix", "witnesses"],
            "properties": {
              "release_digest": { "$ref": "#/$defs/digest" },
              "admission_deadline_unix": { "type": "integer" },
              "witnesses": {
                "type": "array", "minItems": 1, "maxItems": 4,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["repository_id", "snapshot_digest", "release_date_unix", "deadline_unix", "primary_fingerprint"],
                  "properties": {
                    "repository_id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                    "snapshot_digest": { "$ref": "#/$defs/digest" },
                    "release_date_unix": { "type": "integer" },
                    "deadline_unix": { "type": "integer" },
                    "primary_fingerprint": { "$ref": "#/$defs/fingerprint" }
                  }
                }
              }
            }
          }]
        }
      }
    }
  }
}
