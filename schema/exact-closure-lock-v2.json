{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://debz.dev/schema/exact-closure-lock-v2",
  "title": "debz exact solved-closure lock v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "target_architecture", "request_sha256", "policy_sha256", "repositories", "local_artifacts", "packages", "digest_sha256"],
  "properties": {
    "schema": { "const": "https://debz.dev/schema/exact-closure-lock-v2" },
    "version": { "const": 2 },
    "target_architecture": { "type": "string", "minLength": 1 },
    "request_sha256": { "$ref": "#/$defs/sha256" },
    "policy_sha256": { "$ref": "#/$defs/sha256" },
    "repositories": {
      "type": "array",
      "items": { "$ref": "#/$defs/repository" }
    },
    "local_artifacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/localArtifact" }
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/package" }
    },
    "digest_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "architecture"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "architecture": { "type": "string", "minLength": 1 }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "snapshot_sha256", "release_sha256", "index_sha256", "signer_fingerprints"],
      "properties": {
        "id": { "$ref": "#/$defs/sha256" },
        "snapshot_sha256": { "$ref": "#/$defs/sha256" },
        "release_sha256": { "$ref": "#/$defs/sha256" },
        "index_sha256": { "$ref": "#/$defs/sha256" },
        "signer_fingerprints": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/fingerprint" }
        }
      }
    },
    "localArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "sha256", "size", "package", "acquisition_url", "trust_mode"],
      "properties": {
        "artifact_id": { "$ref": "#/$defs/sha256" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size": { "type": "integer", "minimum": 0 },
        "package": { "$ref": "#/$defs/identity" },
        "acquisition_url": { "type": "string", "minLength": 1 },
        "trust_mode": { "enum": ["pinned_sha256", "verified_https"] }
      }
    },
    "repositoryOrigin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "repository_id", "repository_snapshot_sha256"],
      "properties": {
        "type": { "const": "authenticated_repository" },
        "repository_id": { "$ref": "#/$defs/sha256" },
        "repository_snapshot_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "localOrigin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "artifact_id", "sha256", "size", "package", "acquisition_url", "trust_mode"],
      "properties": {
        "type": { "const": "local_artifact" },
        "artifact_id": { "$ref": "#/$defs/sha256" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size": { "type": "integer", "minimum": 0 },
        "package": { "$ref": "#/$defs/identity" },
        "acquisition_url": { "type": "string", "minLength": 1 },
        "trust_mode": { "enum": ["pinned_sha256", "verified_https"] }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "architecture", "origin", "sha256", "declared_size", "retention", "dpkg_selection_hold"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "architecture": { "type": "string", "minLength": 1 },
        "origin": {
          "oneOf": [
            { "$ref": "#/$defs/repositoryOrigin" },
            { "$ref": "#/$defs/localOrigin" }
          ]
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "declared_size": { "type": "integer", "minimum": 0 },
        "retention": { "enum": ["requested", "dependency", "retained"] },
        "dpkg_selection_hold": { "type": "boolean" }
      }
    }
  }
}
