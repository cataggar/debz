{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://debz.dev/schema/system-install-recovery-v1",
  "title": "debz system install recovery record v1",
  "$comment": "Written once when execution may have begun and did not settle. The attempt stays owned and sticky: reruns report recovery_required and are never retried automatically, refreshed, or replanned.",
  "type": "object",
  "additionalProperties": false,
  "required": ["payload", "digest_sha512"],
  "properties": {
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "version", "attempt_id", "request_document_sha512", "progress_document_sha512", "lock",
        "program_document_sha512", "authorization_document_sha512", "command", "guidance", "reason"
      ],
      "properties": {
        "schema": { "const": "https://debz.dev/schema/system-install-recovery-v1" },
        "version": { "const": 1 },
        "attempt_id": { "$ref": "system-install-request-v1.json#/$defs/attemptId" },
        "request_document_sha512": { "$ref": "system-install-request-v1.json#/$defs/sha512" },
        "progress_document_sha512": { "$ref": "system-install-request-v1.json#/$defs/sha512" },
        "lock": { "$ref": "system-install-request-v1.json#/$defs/lockReference" },
        "program_document_sha512": { "$ref": "system-install-request-v1.json#/$defs/sha512" },
        "authorization_document_sha512": { "$ref": "system-install-request-v1.json#/$defs/sha512" },
        "command": { "$ref": "system-install-request-v1.json#/$defs/command" },
        "guidance": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "digest_sha512": { "$ref": "system-install-request-v1.json#/$defs/sha512" }
  }
}
