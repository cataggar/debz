{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://debz.dev/schema/native-execution-progress-v4",
  "title": "debz native execution progress with explicit authority and fresh-root bootstrap v4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "intent_sha256",
    "records",
    "head_sha256",
    "digest_sha256"
  ],
  "properties": {
    "schema": {
      "const": "https://debz.dev/schema/native-execution-progress-v4"
    },
    "version": { "const": 4 },
    "intent_sha256": { "$ref": "#/$defs/sha256" },
    "records": {
      "type": "array",
      "maxItems": 200000,
      "items": { "$ref": "#/$defs/record" }
    },
    "head_sha256": { "$ref": "#/$defs/sha256" },
    "digest_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "program_step", "substep", "ordinal"],
      "properties": {
        "kind": {
          "enum": [
            "filesystem",
            "database",
            "helper",
            "script",
            "compensation",
            "trigger",
            "verification",
            "provenance",
            "cleanup"
          ]
        },
        "program_step": { "type": "integer", "minimum": 0 },
        "substep": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "ordinal": { "type": "integer", "minimum": 0 }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "action",
        "stage",
        "result",
        "previous_sha256",
        "digest_sha256"
      ],
      "properties": {
        "sequence": { "type": "integer", "minimum": 0 },
        "action": { "$ref": "#/$defs/action" },
        "stage": {
          "enum": [
            "prepared",
            "in_flight",
            "outcome",
            "completed",
            "activation",
            "terminal"
          ]
        },
        "result": {
          "enum": [
            "none",
            "applied",
            "rolled_back",
            "exited",
            "not_started",
            "failed",
            "succeeded",
            "recovered",
            "recovery_required"
          ]
        },
        "evidence_sha256": {
          "oneOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        },
        "previous_sha256": { "$ref": "#/$defs/sha256" },
        "digest_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
