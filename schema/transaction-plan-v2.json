{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cataggar/debz/schema/transaction-plan-v2.json",
  "title": "debz deterministic transaction planning result v2",
  "oneOf": [
    {
      "type": "object",
      "required": ["schema_version", "target_architecture", "mode", "actions", "ordered_actions", "summary", "download_bytes", "installed_size_delta_bytes"],
      "properties": {
        "schema_version": { "const": 2 },
        "target_architecture": { "type": "string" },
        "mode": { "enum": ["plan_only", "download_only"] },
        "actions": { "type": "array", "items": { "$ref": "#/$defs/action" } },
        "ordered_actions": { "type": "array", "items": { "$ref": "#/$defs/ordered_action" } },
        "summary": { "$ref": "#/$defs/summary" },
        "download_bytes": { "type": "integer", "minimum": 0 },
        "installed_size_delta_bytes": { "type": "integer" }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["schema_version", "problems"],
      "properties": {
        "schema_version": { "const": 2 },
        "problems": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/problem" } }
      },
      "additionalProperties": false
    }
  ],
  "$defs": {
    "action": {
      "type": "object",
      "required": ["kind", "package", "version", "architecture", "repository", "sha256", "package_size", "installed_size_delta_bytes", "source_package", "prior_installed", "requested", "reason"],
      "properties": {
        "kind": { "enum": ["install", "remove", "upgrade", "downgrade", "reinstall"] },
        "package": { "type": "string" },
        "version": { "type": "string" },
        "architecture": { "type": "string" },
        "repository": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["id", "priority"],
              "properties": {
                "id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                "priority": { "type": "integer" }
              },
              "additionalProperties": false
            }
          ]
        },
        "sha256": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          ]
        },
        "package_size": { "type": ["integer", "null"], "minimum": 0 },
        "installed_size_delta_bytes": { "type": "integer" },
        "source_package": { "type": "string" },
        "prior_installed": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["package", "version", "architecture", "installed_size_kib"],
              "properties": {
                "package": { "type": "string" },
                "version": { "type": "string" },
                "architecture": { "type": "string" },
                "installed_size_kib": { "type": ["integer", "null"], "minimum": 0 }
              },
              "additionalProperties": false
            }
          ]
        },
        "requested": { "type": "boolean" },
        "reason": { "enum": ["explicit_request", "dependency", "recommends", "replacement", "upgrade"] },
        "essential": { "type": "boolean" },
        "has_pre_depends": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "ordered_action": {
      "type": "object",
      "required": ["sequence", "kind", "package", "version", "architecture"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 0 },
        "kind": { "enum": ["bootstrap_extract", "remove", "unpack", "configure_pending"] },
        "package": { "type": "string" },
        "version": { "type": "string" },
        "architecture": { "type": "string" }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": ["installs", "removals", "upgrades", "downgrades", "reinstalls", "download_bytes", "installed_size_delta_bytes"],
      "properties": {
        "installs": { "type": "integer", "minimum": 0 },
        "removals": { "type": "integer", "minimum": 0 },
        "upgrades": { "type": "integer", "minimum": 0 },
        "downgrades": { "type": "integer", "minimum": 0 },
        "reinstalls": { "type": "integer", "minimum": 0 },
        "download_bytes": { "type": "integer", "minimum": 0 },
        "installed_size_delta_bytes": { "type": "integer" }
      },
      "additionalProperties": false
    },
    "problem": {
      "type": "object",
      "required": ["id", "kind", "package", "dependency", "detail", "candidate_rejections", "related_problem_ids"],
      "properties": {
        "id": { "type": "integer", "minimum": 0 },
        "kind": {
          "enum": ["unhealthy_installed_state", "unauthenticated_repository", "duplicate_repository", "unsatisfied_dependency", "conflict", "protected_violation", "held_violation", "essential_violation", "no_candidate", "architecture_mismatch", "version_mismatch", "unsupported_feature", "invalid_policy", "reverse_dependency", "policy_exclusion", "phased_update_excluded", "replacement_violation", "limit_exceeded"]
        },
        "package": { "type": ["string", "null"] },
        "dependency": { "type": ["string", "null"] },
        "detail": { "type": "string" },
        "candidate_rejections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["package", "version", "architecture", "reason", "detail"],
            "properties": {
              "package": { "type": "string" },
              "version": { "type": ["string", "null"] },
              "architecture": { "type": ["string", "null"] },
              "reason": {
                "enum": ["wrong_architecture", "wrong_version", "repository_priority", "held", "protected", "essential", "downgrade_forbidden", "replacement_forbidden", "phased_update", "unsatisfied_relation", "conflict"]
              },
              "detail": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "related_problem_ids": { "type": "array", "items": { "type": "integer", "minimum": 0 } }
      },
      "additionalProperties": false
    }
  }
}
