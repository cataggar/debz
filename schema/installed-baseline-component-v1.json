{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://debz.dev/schema/installed-baseline-component-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "authority", "root", "architecture", "components"],
  "properties": {
    "schema": {"const": "https://debz.dev/schema/installed-baseline-component-v1"},
    "version": {"const": 1},
    "authority": {"const": "installed_component_noop"},
    "root": {"$ref": "#/$defs/root"},
    "architecture": {"type": "string", "minLength": 1, "maxLength": 64},
    "components": {"type": "array", "minItems": 1, "maxItems": 100000, "items": {"$ref": "#/$defs/component"}}
  },
  "$defs": {
    "sha512": {"type": "string", "pattern": "^[0-9a-f]{128}$"},
    "root": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device", "inode", "uid", "gid", "mode"],
      "properties": {
        "device": {"type": "integer", "minimum": 0},
        "inode": {"type": "integer", "minimum": 0},
        "uid": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "gid": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "mode": {"type": "integer", "minimum": 0, "maximum": 4294967295}
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "device", "inode", "uid", "gid", "mode", "size", "modified_nanoseconds", "change_nanoseconds", "sha512"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 4096},
        "kind": {"enum": ["regular", "directory", "symlink"]},
        "device": {"type": "integer", "minimum": 0},
        "inode": {"type": "integer", "minimum": 0},
        "uid": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "gid": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "mode": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "size": {"type": ["integer", "null"], "minimum": 0},
        "modified_nanoseconds": {"type": ["integer", "null"]},
        "change_nanoseconds": {"type": ["integer", "null"]},
        "sha512": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha512"}]}
      },
      "allOf": [{
        "if": {"properties": {"kind": {"const": "directory"}}},
        "then": {"properties": {"size": {"type": "null"}, "modified_nanoseconds": {"type": "null"}, "change_nanoseconds": {"type": "null"}, "sha512": {"type": "null"}}},
        "else": {"properties": {"size": {"type": "integer"}, "modified_nanoseconds": {"type": "integer"}, "change_nanoseconds": {"type": "integer"}, "sha512": {"$ref": "#/$defs/sha512"}}}
      }]
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "status_fields_sha512", "info_stem", "controls", "payload"],
      "properties": {
        "package": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "architecture", "selection"],
          "properties": {
            "name": {"type": "string", "minLength": 1, "maxLength": 255},
            "version": {"type": "string", "minLength": 1, "maxLength": 4096},
            "architecture": {"type": "string", "minLength": 1, "maxLength": 64},
            "selection": {"enum": ["install", "hold"]}
          }
        },
        "status_fields_sha512": {"$ref": "#/$defs/sha512"},
        "info_stem": {"type": "string", "minLength": 1, "maxLength": 4096},
        "controls": {"type": "array", "maxItems": 100000, "items": {"$ref": "#/$defs/file"}},
        "payload": {"type": "array", "maxItems": 100000, "items": {"$ref": "#/$defs/file"}}
      }
    }
  }
}
