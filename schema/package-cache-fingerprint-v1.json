{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cataggar/debz/schema/package-cache-fingerprint-v1.json",
  "title": "debz package-cache fingerprint v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "api_version",
    "capability",
    "lock_schema",
    "lock_schema_version",
    "lock_digest",
    "target_architecture",
    "abi",
    "debz_version",
    "cas_layout",
    "archive_format",
    "payload_policy",
    "origin_mode",
    "acceptance_policy_digest",
    "fingerprint",
    "primary_key",
    "restore_prefix",
    "cache_root",
    "cache_path",
    "maximum_archive_bytes"
  ],
  "properties": {
    "schema": { "const": "io.github.cataggar.debz.package-cache-fingerprint.v1" },
    "api_version": { "const": 1 },
    "capability": { "const": "package-cache-v1" },
    "lock_schema": { "const": "https://debz.dev/schema/exact-closure-lock-v1" },
    "lock_schema_version": { "const": 1 },
    "lock_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "target_architecture": { "type": "string", "minLength": 1, "maxLength": 64 },
    "abi": { "const": "debian-package-archive-v1" },
    "debz_version": { "type": "string", "minLength": 1 },
    "cas_layout": { "const": "packages-v1" },
    "archive_format": { "const": "debz-package-cache-archive-v1" },
    "payload_policy": { "const": "deb-payload-default-limits-v1" },
    "origin_mode": { "const": "exact-lock-v1-authenticated-repository" },
    "acceptance_policy_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "primary_key": { "type": "string", "pattern": "^debz-package-cas-v1-[A-Za-z0-9-]+-[0-9a-f]{64}-[0-9a-f]{64}$" },
    "restore_prefix": { "type": "string", "pattern": "^debz-package-cas-v1-[A-Za-z0-9-]+-[0-9a-f]{64}-$" },
    "cache_root": { "type": "string", "pattern": "^/" },
    "cache_path": { "type": "string", "pattern": "/packages-v1/objects$" },
    "maximum_archive_bytes": { "type": "integer", "minimum": 1 }
  }
}
