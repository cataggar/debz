{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://debz.dev/schema/legacy-capability-evidence-v1",
  "title": "debz legacy execution capability evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "artifact_schema",
    "artifact_version",
    "artifact_sha256",
    "backend",
    "execution",
    "active_recovery",
    "historical_verification",
    "native_reinterpretation",
    "legacy_release_range",
    "guidance",
    "digest_sha256"
  ],
  "properties": {
    "schema": {
      "const": "https://debz.dev/schema/legacy-capability-evidence-v1"
    },
    "version": { "const": 1 },
    "artifact_schema": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "artifact_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "artifact_sha256": { "$ref": "#/$defs/sha256" },
    "backend": { "const": "legacy_dpkg" },
    "execution": { "const": "deprecated_but_available" },
    "active_recovery": {
      "const": "requires_legacy_capable_release"
    },
    "historical_verification": {
      "const": "read_only_exact_bytes"
    },
    "native_reinterpretation": { "const": false },
    "legacy_release_range": { "const": ">=0.3.0,<0.4.0" },
    "guidance": {
      "const": "Recover this operation with debz >=0.3.0,<0.4.0 before installing a native-only release."
    },
    "digest_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
