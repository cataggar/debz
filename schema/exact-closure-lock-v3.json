{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://debz.dev/schema/exact-closure-lock-v3",
  "title": "debz exact solved-closure lock v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "target_architecture", "request_sha256", "policy_sha256", "repositories", "local_artifacts", "packages", "digest_sha256"],
  "properties": {
    "schema": { "const": "https://debz.dev/schema/exact-closure-lock-v3" },
    "version": { "const": 3 },
    "target_architecture": { "type": "string", "minLength": 1 },
    "request_sha256": { "$ref": "#/$defs/sha256" },
    "policy_sha256": { "$ref": "#/$defs/sha256" },
    "repositories": {
      "type": "array",
      "items": { "$ref": "#/$defs/repository" }
    },
    "local_artifacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/localArtifact" }
    },
    "packages": {
      "type": "array",
      "items": { "$ref": "#/$defs/package" }
    },
    "digest_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "sha512": { "type": "string", "pattern": "^[0-9a-f]{128}$" },
    "digest": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "digest"],
          "properties": {
            "algorithm": { "const": "sha256" },
            "digest": { "$ref": "#/$defs/sha256" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "digest"],
          "properties": {
            "algorithm": { "const": "sha512" },
            "digest": { "$ref": "#/$defs/sha512" }
          }
        }
      ]
    },
    "digestIdentity": {
      "oneOf": [
        { "$ref": "#/$defs/sha256Identity" },
        { "$ref": "#/$defs/sha512Identity" },
        { "$ref": "#/$defs/mixedSha256Identity" },
        { "$ref": "#/$defs/mixedSha512Identity" }
      ]
    },
    "sha256Digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "digest"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "sha512Digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "digest"],
      "properties": {
        "algorithm": { "const": "sha512" },
        "digest": { "$ref": "#/$defs/sha512" }
      }
    },
    "sha256Identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "digests"],
      "properties": {
        "primary": { "const": "sha256" },
        "digests": {
          "type": "array",
          "prefixItems": [{ "$ref": "#/$defs/sha256Digest" }],
          "minItems": 1,
          "maxItems": 1
        }
      }
    },
    "sha512Identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "digests"],
      "properties": {
        "primary": { "const": "sha512" },
        "digests": {
          "type": "array",
          "prefixItems": [{ "$ref": "#/$defs/sha512Digest" }],
          "minItems": 1,
          "maxItems": 1
        }
      }
    },
    "mixedSha256Identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "digests"],
      "properties": {
        "primary": { "const": "sha256" },
        "digests": {
          "type": "array",
          "prefixItems": [
            { "$ref": "#/$defs/sha256Digest" },
            { "$ref": "#/$defs/sha512Digest" }
          ],
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "mixedSha512Identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "digests"],
      "properties": {
        "primary": { "const": "sha512" },
        "digests": {
          "type": "array",
          "prefixItems": [
            { "$ref": "#/$defs/sha256Digest" },
            { "$ref": "#/$defs/sha512Digest" }
          ],
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "architecture"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "architecture": { "type": "string", "minLength": 1 }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "snapshot_sha256", "release_sha256", "index_identity", "signer_fingerprints"],
      "properties": {
        "id": { "$ref": "#/$defs/sha256" },
        "snapshot_sha256": { "$ref": "#/$defs/sha256" },
        "release_sha256": { "$ref": "#/$defs/sha256" },
        "index_identity": { "$ref": "#/$defs/digestIdentity" },
        "signer_fingerprints": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/fingerprint" }
        }
      }
    },
    "localArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "archive_identity", "size", "package", "acquisition_url", "trust_mode"],
      "properties": {
        "artifact_id": { "$ref": "#/$defs/digest" },
        "archive_identity": { "$ref": "#/$defs/digestIdentity" },
        "size": { "type": "integer", "minimum": 0 },
        "package": { "$ref": "#/$defs/identity" },
        "acquisition_url": { "type": "string", "minLength": 1 },
        "trust_mode": { "enum": ["pinned_content_digest", "verified_https"] }
      }
    },
    "repositoryOrigin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "repository_id", "repository_snapshot_sha256"],
      "properties": {
        "type": { "const": "authenticated_repository" },
        "repository_id": { "$ref": "#/$defs/sha256" },
        "repository_snapshot_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "localOrigin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "artifact_id", "archive_identity", "size", "package", "acquisition_url", "trust_mode"],
      "properties": {
        "type": { "const": "local_artifact" },
        "artifact_id": { "$ref": "#/$defs/digest" },
        "archive_identity": { "$ref": "#/$defs/digestIdentity" },
        "size": { "type": "integer", "minimum": 0 },
        "package": { "$ref": "#/$defs/identity" },
        "acquisition_url": { "type": "string", "minLength": 1 },
        "trust_mode": { "enum": ["pinned_content_digest", "verified_https"] }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "architecture", "origin", "archive_identity", "declared_size", "retention", "dpkg_selection_hold"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "architecture": { "type": "string", "minLength": 1 },
        "origin": {
          "oneOf": [
            { "$ref": "#/$defs/repositoryOrigin" },
            { "$ref": "#/$defs/localOrigin" }
          ]
        },
        "archive_identity": { "$ref": "#/$defs/digestIdentity" },
        "declared_size": { "type": "integer", "minimum": 0 },
        "retention": { "enum": ["requested", "dependency", "retained"] },
        "dpkg_selection_hold": { "type": "boolean" }
      }
    }
  }
}
