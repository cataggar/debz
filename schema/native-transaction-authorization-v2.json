{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://debz.dev/schema/native-transaction-authorization-v2",
  "title": "debz native transaction authorization v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "backend",
    "target_architecture",
    "foreign_architectures",
    "install_root",
    "root_identity_sha256",
    "request_sha256",
    "solver_policy_sha256",
    "executor_policy_sha256",
    "plan_sha256",
    "exact_lock",
    "policy",
    "actions",
    "trigger_authority",
    "final_state",
    "final_state_sha256",
    "digest_sha256"
  ],
  "properties": {
    "schema": { "const": "https://debz.dev/schema/native-transaction-authorization-v2" },
    "version": { "const": 2 },
    "backend": { "const": "native" },
    "target_architecture": {
      "$ref": "https://debz.dev/schema/native-transaction-authorization-v1#/$defs/identity/properties/architecture"
    },
    "foreign_architectures": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "https://debz.dev/schema/native-transaction-authorization-v1#/$defs/identity/properties/architecture"
      }
    },
    "install_root": {
      "$ref": "https://debz.dev/schema/native-transaction-authorization-v1#/$defs/absolutePath"
    },
    "root_identity_sha256": { "$ref": "#/$defs/sha256" },
    "request_sha256": { "$ref": "#/$defs/sha256" },
    "solver_policy_sha256": { "$ref": "#/$defs/sha256" },
    "executor_policy_sha256": { "$ref": "#/$defs/sha256" },
    "plan_sha256": { "$ref": "#/$defs/sha256" },
    "exact_lock": { "$ref": "#/$defs/lockBinding" },
    "policy": {
      "$ref": "https://debz.dev/schema/native-transaction-authorization-v1#/$defs/policy"
    },
    "actions": {
      "type": "array",
      "maxItems": 100000,
      "items": { "$ref": "#/$defs/action" }
    },
    "trigger_authority": {
      "oneOf": [
        { "type": "null" },
        {
          "$ref": "https://debz.dev/schema/native-transaction-authorization-v1#/$defs/triggerAuthority"
        }
      ]
    },
    "final_state": {
      "type": "array",
      "maxItems": 200000,
      "items": {
        "$ref": "https://debz.dev/schema/native-transaction-authorization-v1#/$defs/finalPackage"
      }
    },
    "final_state_sha256": { "$ref": "#/$defs/sha256" },
    "digest_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sha512": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$"
    },
    "digest": {
      "oneOf": [
        { "$ref": "#/$defs/sha256Digest" },
        { "$ref": "#/$defs/sha512Digest" }
      ]
    },
    "sha256Digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "digest"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "sha512Digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "digest"],
      "properties": {
        "algorithm": { "const": "sha512" },
        "digest": { "$ref": "#/$defs/sha512" }
      }
    },
    "digestIdentity": {
      "oneOf": [
        { "$ref": "#/$defs/sha256Identity" },
        { "$ref": "#/$defs/sha512Identity" },
        { "$ref": "#/$defs/mixedSha256Identity" },
        { "$ref": "#/$defs/mixedSha512Identity" }
      ]
    },
    "sha256Identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "digests"],
      "properties": {
        "primary": { "const": "sha256" },
        "digests": {
          "type": "array",
          "prefixItems": [{ "$ref": "#/$defs/sha256Digest" }],
          "minItems": 1,
          "maxItems": 1
        }
      }
    },
    "sha512Identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "digests"],
      "properties": {
        "primary": { "const": "sha512" },
        "digests": {
          "type": "array",
          "prefixItems": [{ "$ref": "#/$defs/sha512Digest" }],
          "minItems": 1,
          "maxItems": 1
        }
      }
    },
    "mixedSha256Identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "digests"],
      "properties": {
        "primary": { "const": "sha256" },
        "digests": {
          "type": "array",
          "prefixItems": [
            { "$ref": "#/$defs/sha256Digest" },
            { "$ref": "#/$defs/sha512Digest" }
          ],
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "mixedSha512Identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "digests"],
      "properties": {
        "primary": { "const": "sha512" },
        "digests": {
          "type": "array",
          "prefixItems": [
            { "$ref": "#/$defs/sha256Digest" },
            { "$ref": "#/$defs/sha512Digest" }
          ],
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "lockBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "version", "digest_sha256"],
      "properties": {
        "schema": { "const": "https://debz.dev/schema/exact-closure-lock-v3" },
        "version": { "const": 3 },
        "digest_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "repositoryOrigin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "repository_id", "repository_snapshot_sha256"],
      "properties": {
        "type": { "const": "authenticated_repository" },
        "repository_id": { "$ref": "#/$defs/sha256" },
        "repository_snapshot_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "localOrigin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "artifact_id",
        "archive_identity",
        "size",
        "package",
        "acquisition_url",
        "trust_mode"
      ],
      "properties": {
        "type": { "const": "local_artifact" },
        "artifact_id": { "$ref": "#/$defs/digest" },
        "archive_identity": { "$ref": "#/$defs/digestIdentity" },
        "size": { "type": "integer", "minimum": 0 },
        "package": {
          "$ref": "https://debz.dev/schema/native-transaction-authorization-v1#/$defs/identity"
        },
        "acquisition_url": { "type": "string", "minLength": 1 },
        "trust_mode": {
          "enum": ["pinned_content_digest", "verified_https"]
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["archive_identity", "size", "origin"],
      "properties": {
        "archive_identity": { "$ref": "#/$defs/digestIdentity" },
        "size": { "type": "integer", "minimum": 0 },
        "origin": {
          "oneOf": [
            { "$ref": "#/$defs/repositoryOrigin" },
            { "$ref": "#/$defs/localOrigin" }
          ]
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "kind", "package", "prior_version", "artifact"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 0 },
        "kind": {
          "enum": ["install", "remove", "upgrade", "downgrade", "reinstall", "purge"]
        },
        "package": {
          "$ref": "https://debz.dev/schema/native-transaction-authorization-v1#/$defs/identity"
        },
        "prior_version": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1 }
          ]
        },
        "artifact": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/artifact" }
          ]
        }
      }
    }
  }
}
