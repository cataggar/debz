{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cataggar/debz/schema/transaction-plan-v4.json",
  "title": "debz deterministic transaction planning result v4",
  "oneOf": [
    {
      "type": "object",
      "required": ["schema_version", "target_architecture", "mode", "actions", "ordered_actions", "summary", "download_bytes", "installed_size_delta_bytes"],
      "properties": {
        "schema_version": { "const": 4 },
        "target_architecture": { "type": "string" },
        "mode": { "enum": ["plan_only", "download_only"] },
        "actions": { "type": "array", "items": { "$ref": "#/$defs/action" } },
        "ordered_actions": { "type": "array", "items": { "$ref": "#/$defs/ordered_action" } },
        "summary": { "$ref": "#/$defs/summary" },
        "download_bytes": { "type": "integer", "minimum": 0 },
        "installed_size_delta_bytes": { "type": "integer" }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["schema_version", "problems"],
      "properties": {
        "schema_version": { "const": 4 },
        "problems": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/problem" } }
      },
      "additionalProperties": false
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "sha512": { "type": "string", "pattern": "^[0-9a-f]{128}$" },
    "digest": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "digest"],
          "properties": {
            "algorithm": { "const": "sha256" },
            "digest": { "$ref": "#/$defs/sha256" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "digest"],
          "properties": {
            "algorithm": { "const": "sha512" },
            "digest": { "$ref": "#/$defs/sha512" }
          }
        }
      ]
    },
    "sha256Identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "digests"],
      "properties": {
        "primary": { "const": "sha256" },
        "digests": {
          "type": "array",
          "prefixItems": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["algorithm", "digest"],
              "properties": {
                "algorithm": { "const": "sha256" },
                "digest": { "$ref": "#/$defs/sha256" }
              }
            }
          ],
          "minItems": 1,
          "maxItems": 1
        }
      }
    },
    "sha512Identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "digests"],
      "properties": {
        "primary": { "const": "sha512" },
        "digests": {
          "type": "array",
          "prefixItems": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["algorithm", "digest"],
              "properties": {
                "algorithm": { "const": "sha512" },
                "digest": { "$ref": "#/$defs/sha512" }
              }
            }
          ],
          "minItems": 1,
          "maxItems": 1
        }
      }
    },
    "mixedSha256Identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "digests"],
      "properties": {
        "primary": { "const": "sha256" },
        "digests": {
          "type": "array",
          "prefixItems": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["algorithm", "digest"],
              "properties": {
                "algorithm": { "const": "sha256" },
                "digest": { "$ref": "#/$defs/sha256" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["algorithm", "digest"],
              "properties": {
                "algorithm": { "const": "sha512" },
                "digest": { "$ref": "#/$defs/sha512" }
              }
            }
          ],
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "mixedSha512Identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "digests"],
      "properties": {
        "primary": { "const": "sha512" },
        "digests": {
          "type": "array",
          "prefixItems": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["algorithm", "digest"],
              "properties": {
                "algorithm": { "const": "sha256" },
                "digest": { "$ref": "#/$defs/sha256" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["algorithm", "digest"],
              "properties": {
                "algorithm": { "const": "sha512" },
                "digest": { "$ref": "#/$defs/sha512" }
              }
            }
          ],
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "digestIdentity": {
      "oneOf": [
        { "$ref": "#/$defs/sha256Identity" },
        { "$ref": "#/$defs/sha512Identity" },
        { "$ref": "#/$defs/mixedSha256Identity" },
        { "$ref": "#/$defs/mixedSha512Identity" }
      ]
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "architecture"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "architecture": { "type": "string", "minLength": 1 }
      }
    },
    "repositoryOrigin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "priority"],
      "properties": {
        "type": { "const": "authenticated_repository" },
        "id": { "$ref": "#/$defs/sha256" },
        "priority": { "type": "integer" }
      }
    },
    "localOrigin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "artifact_id", "archive_identity", "size", "package", "acquisition_url", "trust_mode", "solver_priority"],
      "properties": {
        "type": { "const": "local_artifact" },
        "artifact_id": { "$ref": "#/$defs/digest" },
        "archive_identity": { "$ref": "#/$defs/digestIdentity" },
        "size": { "type": "integer", "minimum": 0 },
        "package": { "$ref": "#/$defs/identity" },
        "acquisition_url": { "type": "string", "minLength": 1 },
        "trust_mode": { "enum": ["pinned_content_digest", "verified_https"] },
        "solver_priority": { "type": "integer" }
      }
    },
    "action": {
      "type": "object",
      "required": ["kind", "package", "version", "architecture", "origin", "archive_identity", "package_size", "installed_size_delta_bytes", "source_package", "prior_installed", "requested", "reason", "essential", "has_pre_depends"],
      "properties": {
        "kind": { "enum": ["install", "remove", "purge", "upgrade", "downgrade", "reinstall"] },
        "package": { "type": "string" },
        "version": { "type": "string" },
        "architecture": { "type": "string" },
        "origin": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/repositoryOrigin" },
            { "$ref": "#/$defs/localOrigin" }
          ]
        },
        "archive_identity": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/digestIdentity" }] },
        "package_size": { "type": ["integer", "null"], "minimum": 0 },
        "installed_size_delta_bytes": { "type": "integer" },
        "source_package": { "type": "string" },
        "prior_installed": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["package", "version", "architecture", "installed_size_kib"],
              "properties": {
                "package": { "type": "string" },
                "version": { "type": "string" },
                "architecture": { "type": "string" },
                "installed_size_kib": { "type": ["integer", "null"], "minimum": 0 }
              },
              "additionalProperties": false
            }
          ]
        },
        "requested": { "type": "boolean" },
        "reason": { "enum": ["explicit_request", "dependency", "recommends", "replacement", "upgrade"] },
        "essential": { "type": "boolean" },
        "has_pre_depends": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "ordered_action": {
      "type": "object",
      "required": ["sequence", "kind", "package", "version", "architecture"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 0 },
        "kind": { "enum": ["bootstrap_extract", "remove", "purge", "unpack", "configure_pending"] },
        "package": { "type": "string" },
        "version": { "type": "string" },
        "architecture": { "type": "string" }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": ["installs", "removals", "upgrades", "downgrades", "reinstalls", "download_bytes", "installed_size_delta_bytes"],
      "properties": {
        "installs": { "type": "integer", "minimum": 0 },
        "removals": { "type": "integer", "minimum": 0 },
        "upgrades": { "type": "integer", "minimum": 0 },
        "downgrades": { "type": "integer", "minimum": 0 },
        "reinstalls": { "type": "integer", "minimum": 0 },
        "download_bytes": { "type": "integer", "minimum": 0 },
        "installed_size_delta_bytes": { "type": "integer" }
      },
      "additionalProperties": false
    },
    "problem": {
      "type": "object",
      "required": ["id", "kind", "package", "dependency", "detail", "candidate_rejections", "related_problem_ids"],
      "properties": {
        "id": { "type": "integer", "minimum": 0 },
        "kind": { "type": "string", "minLength": 1 },
        "package": { "type": ["string", "null"] },
        "dependency": { "type": ["string", "null"] },
        "detail": { "type": "string" },
        "candidate_rejections": { "type": "array" },
        "related_problem_ids": { "type": "array", "items": { "type": "integer", "minimum": 0 } }
      },
      "additionalProperties": false
    }
  }
}
