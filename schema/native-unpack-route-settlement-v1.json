{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://debz.dev/schema/native-unpack-route-settlement-v1",
  "title": "Native unpack route settlement contract v1",
  "description": "Authenticated route-settlement capability for a recovery-managed installed-package postrm upgrade boundary. Presence alone does not authorize native execution.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "capability",
    "intent_sha256",
    "program_step",
    "unpack_input_sha256",
    "package",
    "aliases",
    "routes",
    "digest_sha256"
  ],
  "properties": {
    "schema": {
      "const": "https://debz.dev/schema/native-unpack-route-settlement-v1"
    },
    "version": {
      "const": 1
    },
    "capability": {
      "const": "postrm_upgrade_route_settlement"
    },
    "intent_sha256": {
      "$ref": "#/$defs/digest"
    },
    "program_step": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "unpack_input_sha256": {
      "description": "Digest of the unchanged native-unpack-diversion-v1 parent evidence.",
      "$ref": "#/$defs/digest"
    },
    "package": {
      "$ref": "#/$defs/package"
    },
    "aliases": {
      "description": "Sorted proven merged-/usr rewrites used by publication and post-script routes.",
      "type": "array",
      "maxItems": 7,
      "items": {
        "$ref": "#/$defs/alias"
      }
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {
        "$ref": "#/$defs/route"
      }
    },
    "digest_sha256": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "architecture"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 255,
          "pattern": "^[a-z0-9][a-z0-9+.-]+$"
        },
        "architecture": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        }
      }
    },
    "alias": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["from", "to"],
          "properties": {
            "from": { "const": "bin" },
            "to": { "const": "usr/bin" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["from", "to"],
          "properties": {
            "from": { "const": "lib" },
            "to": { "const": "usr/lib" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["from", "to"],
          "properties": {
            "from": { "const": "lib32" },
            "to": { "const": "usr/lib32" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["from", "to"],
          "properties": {
            "from": { "const": "lib64" },
            "to": { "const": "usr/lib64" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["from", "to"],
          "properties": {
            "from": { "const": "libo32" },
            "to": { "const": "usr/libo32" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["from", "to"],
          "properties": {
            "from": { "const": "libx32" },
            "to": { "const": "usr/libx32" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["from", "to"],
          "properties": {
            "from": { "const": "sbin" },
            "to": { "const": "usr/sbin" }
          }
        }
      ]
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logical_path",
        "payload_route",
        "post_script_route",
        "settlement",
        "trigger_source",
        "ownership",
        "backup"
      ],
      "properties": {
        "logical_path": {
          "$ref": "#/$defs/path"
        },
        "payload_route": {
          "$ref": "#/$defs/path"
        },
        "post_script_route": {
          "$ref": "#/$defs/postScriptRoute"
        },
        "settlement": {
          "description": "Sorted, globally unique associations to native-unpack-diversion-v1 settlement writes.",
          "type": "array",
          "maxItems": 200000,
          "items": {
            "$ref": "#/$defs/association"
          }
        },
        "trigger_source": {
          "enum": [
            "none",
            "logical",
            "payload",
            "post_script",
            "logical_and_payload",
            "logical_and_post_script"
          ]
        },
        "ownership": {
          "description": "Whether the logical package path belongs to the previous generation, the resulting generation, or both.",
          "enum": [
            "previous",
            "resulting",
            "previous_and_resulting"
          ]
        },
        "backup": {
          "enum": ["none", "discard", "retain"]
        },
        "conffile": {
          "$ref": "#/$defs/conffile"
        }
      }
    },
    "postScriptRoute": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "cache": {
          "type": "object",
          "additionalProperties": false,
          "required": ["digest_sha256"],
          "properties": {
            "digest_sha256": {
              "description": "Digest of an authenticated native-diversion-cache-v1 document.",
              "$ref": "#/$defs/digest"
            }
          }
        }
      },
      "oneOf": [
        { "required": ["path"] },
        { "required": ["cache"] }
      ]
    },
    "association": {
      "type": "object",
      "additionalProperties": false,
      "required": ["write_index", "kind", "route"],
      "properties": {
        "write_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 199999
        },
        "kind": {
          "enum": ["removal", "write"]
        },
        "route": {
          "enum": ["payload", "post_script"]
        }
      }
    },
    "conffile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["staging", "recorded_md5"],
      "properties": {
        "staging": {
          "enum": ["absent", "discard", "retain"]
        },
        "recorded_md5": {
          "$ref": "#/$defs/md5"
        }
      }
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^/\\u0000-\\u001f\\u007f][^\\u0000-\\u001f\\u007f]*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "md5": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    }
  }
}
