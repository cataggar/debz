{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://debz.dev/schema/native-transaction-authorization-v3",
  "title": "Native authenticated new installs with component-bound retained no-ops",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "backend", "target_architecture", "foreign_architectures", "install_root", "root_identity_sha256", "request_sha256", "solver_policy_sha256", "executor_policy_sha256", "plan_sha256", "exact_lock", "policy", "baseline_noop_sha512", "actions", "trigger_authority", "final_state", "final_state_sha256", "digest_sha256"],
  "properties": {
    "schema": {"const": "https://debz.dev/schema/native-transaction-authorization-v3"},
    "version": {"const": 3},
    "backend": {"const": "native"},
    "target_architecture": {"$ref": "https://debz.dev/schema/native-transaction-authorization-v2#/properties/target_architecture"},
    "foreign_architectures": {"$ref": "https://debz.dev/schema/native-transaction-authorization-v2#/properties/foreign_architectures"},
    "install_root": {"$ref": "https://debz.dev/schema/native-transaction-authorization-v2#/properties/install_root"},
    "root_identity_sha256": {"$ref": "https://debz.dev/schema/native-transaction-authorization-v2#/$defs/sha256"},
    "request_sha256": {"$ref": "https://debz.dev/schema/native-transaction-authorization-v2#/$defs/sha256"},
    "solver_policy_sha256": {"$ref": "https://debz.dev/schema/native-transaction-authorization-v2#/$defs/sha256"},
    "executor_policy_sha256": {"$ref": "https://debz.dev/schema/native-transaction-authorization-v2#/$defs/sha256"},
    "plan_sha256": {"$ref": "https://debz.dev/schema/native-transaction-authorization-v2#/$defs/sha256"},
    "exact_lock": {"$ref": "https://debz.dev/schema/native-transaction-authorization-v2#/properties/exact_lock"},
    "policy": {"$ref": "https://debz.dev/schema/native-transaction-authorization-v2#/properties/policy"},
    "baseline_noop_sha512": {"type": "string", "pattern": "^[0-9a-f]{128}$"},
    "actions": {
      "type": "array", "maxItems": 100000,
      "items": {
        "allOf": [
          {"$ref": "https://debz.dev/schema/native-transaction-authorization-v2#/$defs/action"},
          {"properties": {"kind": {"const": "install"}, "prior_version": {"type": "null"}, "artifact": {"type": "object", "properties": {"origin": {"properties": {"kind": {"const": "authenticated_repository"}}}}}}}
        ]
      }
    },
    "trigger_authority": {"type": "null"},
    "final_state": {
      "type": "array", "minItems": 1, "maxItems": 200000,
      "items": {"$ref": "https://debz.dev/schema/native-transaction-authorization-v1#/$defs/finalPackage"}
    },
    "final_state_sha256": {"$ref": "https://debz.dev/schema/native-transaction-authorization-v2#/$defs/sha256"},
    "digest_sha256": {"$ref": "https://debz.dev/schema/native-transaction-authorization-v2#/$defs/sha256"}
  }
}
