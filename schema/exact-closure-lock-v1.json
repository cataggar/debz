{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://debz.dev/schema/exact-closure-lock-v1",
  "title": "debz exact solved-closure lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "target_architecture", "request_sha256", "policy_sha256", "repositories", "packages", "digest_sha256"],
  "properties": {
    "schema": { "const": "https://debz.dev/schema/exact-closure-lock-v1" },
    "version": { "const": 1 },
    "target_architecture": { "type": "string", "minLength": 1 },
    "request_sha256": { "$ref": "#/$defs/sha256" },
    "policy_sha256": { "$ref": "#/$defs/sha256" },
    "repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "snapshot_sha256", "release_sha256", "index_sha256", "signer_fingerprints"],
        "properties": {
          "id": { "$ref": "#/$defs/sha256" },
          "snapshot_sha256": { "$ref": "#/$defs/sha256" },
          "release_sha256": { "$ref": "#/$defs/sha256" },
          "index_sha256": { "$ref": "#/$defs/sha256" },
          "signer_fingerprints": { "type": "array", "items": { "type": "string", "pattern": "^[0-9a-f]{40}$" } }
        }
      }
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "architecture", "repository_id", "repository_snapshot_sha256", "sha256", "declared_size", "retention", "dpkg_selection_hold"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "architecture": { "type": "string", "minLength": 1 },
          "repository_id": { "$ref": "#/$defs/sha256" },
          "repository_snapshot_sha256": { "$ref": "#/$defs/sha256" },
          "sha256": { "$ref": "#/$defs/sha256" },
          "declared_size": { "type": "integer", "minimum": 0 },
          "retention": { "enum": ["requested", "dependency", "retained"] },
          "dpkg_selection_hold": { "type": "boolean" }
        }
      }
    },
    "digest_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
