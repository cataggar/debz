{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://debz.dev/schema/system-operation-lock-v1",
  "title": "debz standalone system operation lock v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "operation",
    "target_architecture",
    "request_sha256",
    "solver_policy_sha256",
    "executor_policy_sha256",
    "plan_sha256",
    "package_lock_kind",
    "package_lock_sha256",
    "actions",
    "digest_sha256"
  ],
  "properties": {
    "schema": { "const": "https://debz.dev/schema/system-operation-lock-v1" },
    "version": { "const": 1 },
    "operation": {
      "enum": ["install", "remove", "upgrade", "upgrade-all", "reinstall"]
    },
    "target_architecture": { "type": "string", "minLength": 1 },
    "request_sha256": { "$ref": "#/$defs/sha256" },
    "solver_policy_sha256": { "$ref": "#/$defs/sha256" },
    "executor_policy_sha256": { "$ref": "#/$defs/sha256" },
    "plan_sha256": { "$ref": "#/$defs/sha256" },
    "package_lock_kind": { "enum": ["none", "exact_v1", "exact_v2"] },
    "package_lock_sha256": {
      "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "package", "version", "architecture"],
        "properties": {
          "kind": {
            "enum": ["install", "remove", "upgrade", "downgrade", "reinstall"]
          },
          "package": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "architecture": { "type": "string", "minLength": 1 }
        }
      }
    },
    "digest_sha256": { "$ref": "#/$defs/sha256" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "package_lock_kind": { "const": "none" } }
      },
      "then": {
        "properties": { "package_lock_sha256": { "type": "null" } }
      },
      "else": {
        "properties": {
          "package_lock_sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
