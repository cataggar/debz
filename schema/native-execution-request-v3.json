{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://debz.dev/schema/native-execution-request-v3",
  "title": "debz native execution request with authenticated fresh-root helper bootstrap v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "execution", "bootstrap", "digest_sha256"],
  "properties": {
    "schema": {"const": "https://debz.dev/schema/native-execution-request-v3"},
    "version": {"const": 3},
    "execution": {"$ref": "https://debz.dev/schema/native-execution-request-v1"},
    "bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_id",
        "root_identity_sha256",
        "root_inode",
        "root_uid",
        "root_gid",
        "plan_sha256",
        "authorization_sha256",
        "program_sha256",
        "exact_lock_schema",
        "exact_lock_version",
        "exact_lock_sha256",
        "helper",
        "owner",
        "target"
      ],
      "properties": {
        "attempt_id": {"$ref": "#/$defs/digest"},
        "root_identity_sha256": {"$ref": "#/$defs/digest"},
        "root_inode": {"type": "integer", "minimum": 1},
        "root_uid": {"const": 0},
        "root_gid": {"const": 0},
        "plan_sha256": {"$ref": "#/$defs/digest"},
        "authorization_sha256": {"$ref": "#/$defs/digest"},
        "program_sha256": {"$ref": "#/$defs/digest"},
        "exact_lock_schema": {
          "const": "https://debz.dev/schema/exact-closure-lock-v2"
        },
        "exact_lock_version": {"const": 2},
        "exact_lock_sha256": {"$ref": "#/$defs/digest"},
        "helper": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_path", "target_path", "sha256", "size"],
          "properties": {
            "source_path": {
              "type": "string",
              "pattern": "^var/lib/debz/native-recovery-v1/helper-[0-9a-f]{64}\\.bin$"
            },
            "target_path": {"const": "usr/bin/dpkg-trigger"},
            "sha256": {"$ref": "#/$defs/digest"},
            "size": {"type": "integer", "minimum": 1, "maximum": 33554432}
          }
        },
        "owner": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "package",
            "version",
            "architecture",
            "final_state",
            "artifact",
            "archive_sha256",
            "archive_size",
            "application_sha256",
            "program_step"
          ],
          "properties": {
            "package": {"const": "dpkg"},
            "version": {"type": "string", "minLength": 1},
            "architecture": {"type": "string", "minLength": 1},
            "final_state": {
              "enum": ["installed", "triggers_pending", "triggers_awaited"]
            },
            "artifact": {"type": "integer", "minimum": 0},
            "archive_sha256": {"$ref": "#/$defs/digest"},
            "archive_size": {"type": "integer", "minimum": 1},
            "application_sha256": {"$ref": "#/$defs/digest"},
            "program_step": {"type": "integer", "minimum": 0}
          }
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256", "size", "mode", "uid", "gid"],
          "properties": {
            "path": {"const": "usr/bin/dpkg-trigger"},
            "sha256": {"$ref": "#/$defs/digest"},
            "size": {"type": "integer", "minimum": 1, "maximum": 33554432},
            "mode": {"type": "integer", "minimum": 0, "maximum": 4095},
            "uid": {"type": "integer", "minimum": 0, "maximum": 4294967295},
            "gid": {"type": "integer", "minimum": 0, "maximum": 4294967295}
          }
        }
      }
    },
    "digest_sha256": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
