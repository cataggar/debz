{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://debz.dev/schema/native-install-capability-v1",
  "title": "Native install capability",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "api_version", "backend", "capability", "result_schema",
    "result_api_version", "summary_schema", "summary_api_version",
    "receipt_binding", "unchanged_without_receipt"
  ],
  "properties": {
    "schema": { "const": "io.github.cataggar.debz.native-install-capability.v1" },
    "api_version": { "const": 1 },
    "backend": { "const": "native" },
    "capability": { "const": "native-install-v1" },
    "result_schema": { "const": "io.github.cataggar.debz.native-install-result.v1" },
    "result_api_version": { "const": 1 },
    "summary_schema": { "const": "io.github.cataggar.debz.transaction-result-summary.v2" },
    "summary_api_version": { "const": 2 },
    "receipt_binding": { "const": true },
    "unchanged_without_receipt": { "const": true }
  }
}
