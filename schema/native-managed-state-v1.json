{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://debz.dev/schema/native-managed-state-v1",
  "title": "debz native managed state v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "intent_sha256",
    "generation",
    "history",
    "stable",
    "transient",
    "digest_sha256"
  ],
  "properties": {
    "schema": {
      "const": "https://debz.dev/schema/native-managed-state-v1"
    },
    "version": {
      "const": 1
    },
    "intent_sha256": {
      "$ref": "#/$defs/digest"
    },
    "generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4096
    },
    "history": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/boundary"
      }
    },
    "stable": {
      "oneOf": [
        {
          "$ref": "#/$defs/snapshot"
        },
        {
          "type": "null"
        }
      ]
    },
    "transient": {
      "oneOf": [
        {
          "$ref": "#/$defs/snapshot"
        },
        {
          "type": "null"
        }
      ]
    },
    "digest_sha256": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "program_step",
        "substep",
        "ordinal"
      ],
      "properties": {
        "kind": {
          "enum": [
            "filesystem",
            "database",
            "script",
            "compensation",
            "trigger",
            "verification",
            "provenance",
            "cleanup"
          ]
        },
        "program_step": {
          "type": "integer",
          "minimum": 0
        },
        "substep": {
          "type": "integer",
          "minimum": 0
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "kind",
        "mode",
        "uid",
        "gid",
        "device",
        "inode",
        "link_count",
        "modified_nanoseconds",
        "change_nanoseconds",
        "size",
        "content_sha256",
        "link_target",
        "directory_sha256",
        "directory_entries"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "kind": {
          "enum": [
            "absent",
            "regular",
            "symlink",
            "directory"
          ]
        },
        "mode": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4095
        },
        "uid": {
          "type": "integer",
          "minimum": 0
        },
        "gid": {
          "type": "integer",
          "minimum": 0
        },
        "device": {
          "type": "integer",
          "minimum": 0
        },
        "inode": {
          "type": "integer",
          "minimum": 0
        },
        "link_count": {
          "type": "integer",
          "minimum": 0
        },
        "modified_nanoseconds": {
          "type": "integer"
        },
        "change_nanoseconds": {
          "type": "integer"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "content_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "link_target": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4095
        },
        "directory_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "directory_entries": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation",
        "action",
        "snapshot_sha256",
        "transient"
      ],
      "properties": {
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "action": {
          "$ref": "#/$defs/action"
        },
        "snapshot_sha256": {
          "$ref": "#/$defs/digest"
        },
        "transient": {
          "type": "boolean"
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "progress_head_sha256",
        "entries",
        "digest_sha256"
      ],
      "properties": {
        "action": {
          "$ref": "#/$defs/action"
        },
        "progress_head_sha256": {
          "$ref": "#/$defs/digest"
        },
        "entries": {
          "type": "array",
          "maxItems": 200000,
          "items": {
            "$ref": "#/$defs/entry"
          }
        },
        "digest_sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    }
  }
}
