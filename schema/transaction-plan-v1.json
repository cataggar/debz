{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cataggar/debz/schema/transaction-plan-v1.json",
  "title": "debz deterministic transaction planning result v1",
  "oneOf": [
    {
      "type": "object",
      "required": ["schema_version", "target_architecture", "actions", "download_bytes", "installed_size_delta_bytes"],
      "properties": {
        "schema_version": { "const": 1 },
        "target_architecture": { "type": "string" },
        "actions": { "type": "array", "items": { "$ref": "#/$defs/action" } },
        "download_bytes": { "type": "integer", "minimum": 0 },
        "installed_size_delta_bytes": { "type": "integer" }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["schema_version", "problems"],
      "properties": {
        "schema_version": { "const": 1 },
        "problems": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/problem" } }
      },
      "additionalProperties": false
    }
  ],
  "$defs": {
    "action": {
      "type": "object",
      "required": ["kind", "package", "version", "architecture", "repository", "sha256", "package_size", "installed_size_delta_bytes", "source_package", "prior_installed", "reason"],
      "properties": {
        "kind": { "enum": ["install", "remove", "upgrade", "downgrade", "reinstall"] },
        "package": { "type": "string" },
        "version": { "type": "string" },
        "architecture": { "type": "string" },
        "repository": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["id", "priority"],
              "properties": {
                "id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                "priority": { "type": "integer" }
              },
              "additionalProperties": false
            }
          ]
        },
        "sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "package_size": { "type": ["integer", "null"], "minimum": 0 },
        "installed_size_delta_bytes": { "type": "integer" },
        "source_package": { "type": "string" },
        "prior_installed": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["package", "version", "architecture", "installed_size_kib"],
              "properties": {
                "package": { "type": "string" },
                "version": { "type": "string" },
                "architecture": { "type": "string" },
                "installed_size_kib": { "type": ["integer", "null"], "minimum": 0 }
              },
              "additionalProperties": false
            }
          ]
        },
        "reason": { "enum": ["explicit_request", "dependency", "recommends", "replacement", "upgrade"] }
      },
      "additionalProperties": false
    },
    "problem": {
      "type": "object",
      "required": ["kind", "package", "dependency", "detail"],
      "properties": {
        "kind": {
          "enum": ["unhealthy_installed_state", "unauthenticated_repository", "duplicate_repository", "unsatisfied_dependency", "conflict", "protected_violation", "held_violation", "essential_violation", "no_candidate", "architecture_mismatch", "version_mismatch", "unsupported_feature", "limit_exceeded"]
        },
        "package": { "type": ["string", "null"] },
        "dependency": { "type": ["string", "null"] },
        "detail": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
