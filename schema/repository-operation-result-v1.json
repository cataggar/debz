{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://debz.dev/schema/repository-operation-result-v1",
  "title": "debz repository operation result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "version", "api_version", "operation", "acquired", "validated",
    "authenticated", "planned", "installed_phase", "imported",
    "refreshed_phase", "changed", "installed", "refreshed", "descriptor",
    "paths", "exit_status", "summary", "diagnostics", "digest_sha256"
  ],
  "properties": {
    "schema": { "const": "https://debz.dev/schema/repository-operation-result-v1" },
    "version": { "const": 1 },
    "api_version": { "const": 1 },
    "operation": { "const": "add" },
    "acquired": { "$ref": "#/$defs/mainPhaseState" },
    "validated": { "$ref": "#/$defs/mainPhaseState" },
    "authenticated": { "$ref": "#/$defs/mainPhaseState" },
    "planned": { "$ref": "#/$defs/mainPhaseState" },
    "installed_phase": { "$ref": "#/$defs/mainPhaseState" },
    "imported": { "$ref": "#/$defs/mainPhaseState" },
    "refreshed_phase": { "$ref": "#/$defs/refreshPhaseState" },
    "changed": { "type": "boolean" },
    "installed": { "type": "boolean" },
    "refreshed": { "type": "boolean" },
    "descriptor": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/descriptor" }
      ]
    },
    "paths": { "$ref": "#/$defs/paths" },
    "exit_status": { "enum": [0, 2, 3, 4, 5, 6, 7, 8, 9, 70] },
    "summary": { "type": "string", "minLength": 1 },
    "diagnostics": {
      "type": "array",
      "maxItems": 8,
      "items": { "$ref": "#/$defs/diagnostic" }
    },
    "digest_sha256": { "$ref": "#/$defs/sha256" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "exit_status": { "const": 0 } },
        "required": ["exit_status"]
      },
      "then": {
        "properties": {
          "acquired": { "const": "complete" },
          "validated": { "const": "complete" },
          "authenticated": { "const": "complete" },
          "planned": { "const": "complete" },
          "installed_phase": { "const": "complete" },
          "imported": { "const": "complete" },
          "refreshed_phase": { "enum": ["complete", "skipped"] },
          "installed": { "const": true },
          "descriptor": { "$ref": "#/$defs/descriptor" },
          "paths": {
            "allOf": [
              { "$ref": "#/$defs/paths" },
              {
                "properties": {
                  "exact_lock": { "$ref": "#/$defs/logicalPath" },
                  "provenance": { "$ref": "#/$defs/logicalPath" },
                  "target_manifest": { "$ref": "#/$defs/logicalPath" },
                  "operation_state": { "$ref": "#/$defs/logicalPath" }
                }
              }
            ]
          },
          "diagnostics": { "maxItems": 0 }
        }
      }
    },
    {
      "if": {
        "properties": { "refreshed_phase": { "const": "complete" } },
        "required": ["refreshed_phase"]
      },
      "then": {
        "properties": { "refreshed": { "const": true } }
      }
    },
    {
      "if": {
        "properties": { "refreshed_phase": { "const": "skipped" } },
        "required": ["refreshed_phase"]
      },
      "then": {
        "properties": { "refreshed": { "const": false } }
      }
    },
    {
      "if": {
        "properties": { "validated": { "enum": ["complete", "failed"] } },
        "required": ["validated"]
      },
      "then": { "properties": { "acquired": { "const": "complete" } } }
    },
    {
      "if": {
        "properties": { "authenticated": { "enum": ["complete", "failed"] } },
        "required": ["authenticated"]
      },
      "then": { "properties": { "validated": { "const": "complete" } } }
    },
    {
      "if": {
        "properties": { "planned": { "enum": ["complete", "failed"] } },
        "required": ["planned"]
      },
      "then": { "properties": { "authenticated": { "const": "complete" } } }
    },
    {
      "if": {
        "properties": { "installed_phase": { "enum": ["complete", "failed"] } },
        "required": ["installed_phase"]
      },
      "then": { "properties": { "planned": { "const": "complete" } } }
    },
    {
      "if": {
        "properties": { "imported": { "enum": ["complete", "failed"] } },
        "required": ["imported"]
      },
      "then": { "properties": { "installed_phase": { "const": "complete" } } }
    },
    {
      "if": {
        "properties": {
          "refreshed_phase": { "enum": ["complete", "skipped", "failed"] }
        },
        "required": ["refreshed_phase"]
      },
      "then": { "properties": { "imported": { "const": "complete" } } }
    },
    {
      "if": {
        "properties": { "installed": { "const": true } },
        "required": ["installed"]
      },
      "then": { "properties": { "installed_phase": { "const": "complete" } } }
    },
    {
      "if": {
        "properties": { "installed_phase": { "const": "complete" } },
        "required": ["installed_phase"]
      },
      "then": { "properties": { "installed": { "const": true } } }
    },
    {
      "if": {
        "properties": { "refreshed": { "const": true } },
        "required": ["refreshed"]
      },
      "then": { "properties": { "refreshed_phase": { "const": "complete" } } }
    },
    {
      "if": {
        "properties": { "changed": { "const": true } },
        "required": ["changed"]
      },
      "then": { "properties": { "installed": { "const": true } } }
    },
    {
      "if": {
        "properties": { "exit_status": { "not": { "const": 0 } } },
        "required": ["exit_status"]
      },
      "then": { "properties": { "diagnostics": { "minItems": 1 } } }
    }
  ],
  "$defs": {
    "mainPhaseState": {
      "enum": ["pending", "complete", "failed"]
    },
    "refreshPhaseState": {
      "enum": ["pending", "complete", "skipped", "failed"]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "logicalPath": {
      "type": "string",
      "pattern": "^(?:/|/(?!\\.{1,2}(?:/|$))[^/\\\\\\u0000-\\u001f\\u007f]+(?:/(?!\\.{1,2}(?:/|$))[^/\\\\\\u0000-\\u001f\\u007f]+)*)$"
    },
    "descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package", "version", "architecture", "sha256", "size",
        "effective_url", "trust_mode"
      ],
      "properties": {
        "package": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "architecture": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size": { "type": "integer", "minimum": 1 },
        "effective_url": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^?#]+(?:\\?REDACTED)?$"
        },
        "trust_mode": { "enum": ["verified_https", "pinned_sha256"] }
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exact_lock", "provenance", "target_manifest", "operation_state"],
      "properties": {
        "exact_lock": {
          "oneOf": [{ "$ref": "#/$defs/logicalPath" }, { "type": "null" }]
        },
        "provenance": {
          "oneOf": [{ "$ref": "#/$defs/logicalPath" }, { "type": "null" }]
        },
        "target_manifest": {
          "oneOf": [{ "$ref": "#/$defs/logicalPath" }, { "type": "null" }]
        },
        "operation_state": {
          "oneOf": [{ "$ref": "#/$defs/logicalPath" }, { "type": "null" }]
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "phase", "message"],
      "properties": {
        "id": {
          "enum": [
            "unsupported_api_version", "invalid_request", "invalid_root",
            "invalid_descriptor_url", "credential_bearing_url",
            "insecure_unpinned_url", "invalid_digest",
            "target_configuration_failed", "architecture_unavailable",
            "acquisition_failed", "descriptor_invalid", "descriptor_dynamic",
            "descriptor_trust_unresolved", "repository_authentication_failed",
            "dependency_planning_failed", "dependency_refresh_failed",
            "dependency_acquisition_failed", "existing_descriptor_conflict",
            "managed_file_conflict", "lock_publication_failed",
            "transaction_backend_unavailable", "transaction_failed", "installed_verification_failed",
            "target_import_failed", "refresh_failed",
            "provenance_publication_failed", "resource_limit_exceeded",
            "state_persistence_failed", "state_corrupt",
            "recovery_required", "internal_error"
          ]
        },
        "phase": {
          "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        },
        "message": { "type": "string", "minLength": 1 }
      }
    }
  }
}
