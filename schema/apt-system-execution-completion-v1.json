{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://debz.dev/schema/apt-system-execution-completion-v1",
  "title": "debz apt/system execution completion v1",
  "description": "Ordinary or recovered apt/system completion evidence published only after the retained exact lock and transaction result verify and the private live-root runner reports the root operation completed. This is not the recovery-only root-operation completion discharge document.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "attempt_id",
    "request_sha256",
    "profile",
    "exact_lock",
    "transaction_result",
    "root_operation_status",
    "recovered",
    "completed_unix",
    "digest_sha256"
  ],
  "properties": {
    "schema": {
      "const": "https://debz.dev/schema/apt-system-execution-completion-v1"
    },
    "version": { "const": 1 },
    "attempt_id": { "$ref": "#/$defs/sha256" },
    "request_sha256": { "$ref": "#/$defs/sha256" },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "reference_evidence_sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/absolutePath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "reference_evidence_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "exact_lock": { "$ref": "#/$defs/document" },
    "transaction_result": { "$ref": "#/$defs/document" },
    "root_operation_status": { "const": "completed" },
    "recovered": { "type": "boolean" },
    "completed_unix": { "type": "integer" },
    "digest_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "absolutePath": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^(?:/|/(?!\\.{1,2}(?:/|$))[^/\\\\\\u0000-\\u001f\\u007f]+(?:/(?!\\.{1,2}(?:/|$))[^/\\\\\\u0000-\\u001f\\u007f]+)*)$",
      "not": { "const": "/" }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "schema", "version", "digest_sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/absolutePath" },
        "schema": { "type": "string", "minLength": 1, "maxLength": 256 },
        "version": { "type": "integer", "minimum": 1 },
        "digest_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
