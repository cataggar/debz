  "generated_contracts": [
    {
      "path": "actions/download/dist/index.js",
      "source": "actions/download/src",
      "required_evidence": "backend-capability"
    },
    {
      "path": "actions/install/dist/index.js",
      "source": "actions/install/src",
      "required_evidence": "backend-capability"
    }
  ],
  "cutover_blockers": [
    "active_legacy_root_operations_recovered_or_refused_with_version_guidance",
    "legacy_journal_execution_deleted_but_historical_decoders_retained",
    "legacy_product_repository_package_family_and_actions_selectors_deleted",
    "system_profile_v1_execution_deleted_but_exact_byte_decoder_retained",
    "legacy_lock_and_result_generation_deleted",
    "release_and_actions_defaults_changed_only_in_cutover_increment"
  ]
