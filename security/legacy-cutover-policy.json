    },
    {
      "path": "src/repository_cli.zig",
      "role": "repository_cli_legacy_backend_selector",
      "cutover": "delete_legacy_selection"
    },
    {
      "path": "src/apt_system_orchestrator.zig",
      "role": "system_facade_legacy_profile_execution",
      "cutover": "delete_legacy_execution_retain_state_decoder"
    },
    {
      "path": "actions/download/src/inputs.ts",
      "role": "download_action_legacy_selector",
      "cutover": "remove_legacy_input_value"
    },
    {
      "path": "actions/download/src/action.ts",
      "role": "download_action_legacy_capability_and_dispatch",
      "cutover": "remove_legacy_dispatch_retain_historical_diagnostic"
    },
    {
      "path": "actions/download/src/runner.ts",
      "role": "download_action_legacy_contract_verifier",
      "cutover": "remove_legacy_execution_retain_historical_verifier_if_required"
    },
    {
      "path": "actions/download/action.yml",
      "role": "download_action_legacy_default",
      "cutover": "change_default_and_remove_legacy_input"
    },
    {
      "path": "actions/install/src/inputs.ts",
      "role": "install_action_legacy_selector",
      "cutover": "remove_legacy_input_value"
    },
    {
      "path": "actions/install/src/action.ts",
      "role": "install_action_legacy_capability_and_dispatch",
      "cutover": "remove_legacy_dispatch_retain_historical_diagnostic"
    },
    {
      "path": "actions/install/src/runner.ts",
      "role": "install_action_legacy_result_verifier",
      "cutover": "remove_legacy_execution_retain_historical_verifier_if_required"
    },
    {
      "path": "actions/install/action.yml",
      "role": "install_action_legacy_default",
      "cutover": "change_default_and_remove_legacy_input"
    }
  ],
  "historical_reference_paths": [
    {
      "path": "src/exact_lock.zig",
      "role": "exact_lock_v1_decoder_and_verifier",
      "retain_after_cutover": true
    },
    {
      "path": "src/transaction_provenance.zig",
      "role": "transaction_result_v1_decoder_and_verifier",
      "retain_after_cutover": true
    },
    {
      "path": "src/transaction_provenance_v2.zig",
      "role": "transaction_result_v2_decoder_and_verifier",
      "retain_after_cutover": true
    },
    {
      "path": "src/root_operation.zig",
      "role": "active_record_decoder_and_typed_refusal",
      "retain_after_cutover": true
    },
    {
      "path": "src/root_operation_completion.zig",
      "role": "completed_operation_verifier",
      "retain_after_cutover": true
    },
    {
      "path": "tools/prepare-native-dpkg.py",
      "role": "pinned_reference_transport",
      "retain_after_cutover": true
    },
    {
      "path": "tools/native-differential.py",
      "role": "reference_oracle_comparison",
      "retain_after_cutover": true
    }
