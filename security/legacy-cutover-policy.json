{
  "schema": "https://debz.dev/schema/legacy-compatibility-policy-v1",
  "version": 1,
  "issue": 86,
  "current_release_mode": "legacy_capable",
  "legacy_capable_release_range": ">=0.3.0,<0.4.0",
  "native_only_cutover_ready": false,
  "invariants": {
    "legacy_is_never_native_authority": true,
    "active_legacy_requires_legacy_capable_recovery": true,
    "native_only_must_not_clear_active_legacy": true,
    "completed_history_is_read_only": true,
    "historical_bytes_are_never_rewritten": true,
    "no_fallback_after_native_mutation": true,
    "no_success_shaped_default": true,
    "single_root_operation_namespace": true
  },
  "artifact_policy": [
