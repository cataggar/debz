      "completed_history": "canonical_digest_read_only"
    },
    {
      "schema": "https://debz.dev/schema/exact-closure-lock-v2",
      "versions": [2],
      "backend": "native",
      "new_execution": "native_only",
      "active_recovery": "native_only",
      "completed_history": "canonical_digest_read_only"
    },
    {
      "schema": "https://debz.dev/schema/transaction-result-v1",
      "versions": [1],
      "backend": "legacy_dpkg",
      "new_execution": "deprecated_but_available",
      "active_recovery": "legacy_capable_release_required",
      "completed_history": "canonical_digest_read_only"
    },
    {
      "schema": "https://debz.dev/schema/transaction-result-v2",
