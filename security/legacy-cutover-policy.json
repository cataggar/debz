  "production_execution_paths": [
    {
      "path": "src/transaction_executor.zig",
      "role": "legacy_dpkg_command_execution",
      "cutover": "delete"
    },
    {
      "path": "src/transaction_recovery.zig",
      "role": "legacy_dpkg_journal_and_recovery",
      "cutover": "retain_decoder_split_execution"
    },
    {
      "path": "src/transaction_engine.zig",
      "role": "legacy_backend_selector_and_executor",
      "cutover": "delete_legacy_selector"
    },
    {
      "path": "src/production_backend.zig",
      "role": "product_legacy_backend_routes",
      "cutover": "delete_legacy_execution_retain_historical_verification"
    },
    {
      "path": "src/repository_backend.zig",
      "role": "repository_legacy_backend_routes",
      "cutover": "delete_legacy_execution_retain_historical_verification"
    },
    {
      "path": "src/package_family_backend.zig",
      "role": "package_family_legacy_selector",
      "cutover": "delete_legacy_execution_retain_v1_capability_history"
    },
    {
      "path": "src/system_profile.zig",
