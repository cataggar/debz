      "backend": "legacy_dpkg",
      "new_execution": "deprecated_but_available",
      "active_recovery": "legacy_capable_release_required",
      "completed_history": "exact_bytes_read_only"
    },
    {
      "schema": "https://debz.dev/schema/system-profile-v2",
      "versions": [2],
      "backend": "explicit",
      "new_execution": "selected_backend_only",
      "active_recovery": "selected_backend_only",
      "completed_history": "exact_bytes_read_only"
    },
    {
      "schema": "https://debz.dev/schema/exact-closure-lock-v1",
