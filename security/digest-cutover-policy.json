{
  "schema": "https://debz.dev/security/digest-cutover-policy-v3",
  "version": 3,
  "issue": 86,
  "fingerprint_algorithm": "sha512",
  "scope": {
    "roots": [
      ".github",
      "actions",
      "build",
      "doc",
      "fuzz",
      "schema",
      "security",
      "src",
      "test",
      "tools"
    ],
    "top_level_files": [
      "README.md",
      "build.zig",
      "build.zig.zon"
    ],
    "excluded_finding_paths": [
      "security/digest-cutover-policy.json",
      "security/digest-inventory-v1.tsv",
      "security/digest-semantic-allowlist-v1.tsv",
      "tools/security-audit.py"
    ],
    "exclusion_rationale": "The repository manifest includes tracked and non-ignored untracked files so pre-commit audit results remain stable after commit. The policy, per-file inventory, semantic allowlist inventory, and audit/canary implementation are excluded from token findings to avoid recursive self-classification; they do not define repository digest authority."
  },
  "authority_policy": {
    "current_package_repository_artifact_authority": "content_digest.Identity, content_digest.Value, content_digest.Set, or their versioned algorithm-tagged serialized forms",
    "sha256_only_authority": "forbidden",
    "raw_32_byte_authority": "forbidden",
    "fixed_64_hex_authority": "forbidden",
    "fixed_sha256_cas_layout": "forbidden",
    "historical_and_control_exception_rule": "exact-path, exact-fingerprint, version-specific or frozen-control classification with a non-empty rationale"
  },
  "inventory": {
    "file": "security/digest-inventory-v1.tsv",
    "format": "tsv-v1",
    "columns": [
      "path",
      "scope",
      "cas_layout",
      "digest_version",
      "fixed_64_hex",
      "raw_32_byte",
      "sha256_token",
      "sha512"
    ],
    "classifications": [
      {
        "scope": ".github",
        "classification": "external_integrity_protocol",
        "rationale": "Workflow SHA256 values are frozen installer and CI compatibility inputs; package authorities are independently rejected by semantic checks."
      },
      {
        "scope": "actions",
        "classification": "external_and_generated_protocol",
        "rationale": "Action source, tests, and checked-in bundles retain external integrity and compatibility tokens; they cannot authorize raw package identities."
      },
      {
        "scope": "build",
        "classification": "dependency_and_build_integrity",
        "rationale": "Build manifests and repository-local dependency configuration use reviewed external integrity pins, not package or repository content authority."
      },
      {
        "scope": "doc",
        "classification": "documented_compatibility",
        "rationale": "Documentation names typed current identities and explicitly described historical or control SHA256 contracts; prose never grants runtime authority."
      },
      {
        "scope": "fuzz",
        "classification": "test_and_fixture_coverage",
        "rationale": "Fuzz harnesses and tracked corpora exercise current typed identities and frozen compatibility decoders without defining production authority."
      },
      {
        "scope": "schema",
        "classification": "versioned_contracts",
        "rationale": "Schemas mix current typed identity contracts with explicitly versioned historical and control SHA256 fields checked by the semantic allowlist."
      },
      {
        "scope": "security",
        "classification": "security_policy_metadata",
        "rationale": "Security metadata records reviewed dependency and compatibility integrity values and is not package, repository, or artifact authority."
      },
      {
        "scope": "src",
        "classification": "typed_authority_and_frozen_controls",
        "rationale": "Production sources use content_digest typed identities for current package authorities while retaining reviewed control hashes, including exact authenticated less, bash, procps configure and bounded triggered callback, sudo-rs and python3 install-only invalid-name and redirected-tool witness, util-linux, console-setup-linux, console-setup and chrony signed debconf script-path and sidecar gates, keyboard and iproute2 maintainer-script/template gates, separate exact signed systemd boot-ID-only, udev PID-only and sudo PID-only proc isolation, signed sudo ownership, alternatives restoration and its pinned sourced dpkg helper fragment, bounded glib automatic file-trigger self-interest exclusion, failed-trigger incorporation and netcat regressions, and versioned compatibility readers."
      },
      {
        "scope": "test",
        "classification": "test_and_fixture_coverage",
        "rationale": "Tracked test sources exercise current typed identities and frozen compatibility fields without defining production digest authority. Recovery selector mutation controls protect both journal/staging and publication runners and their pinned dpkg handoffs."
      },
      {
        "scope": "tools",
        "classification": "release_and_reference_tooling",
        "rationale": "Release, reference, fixture, and audit tooling retains reviewed external or control hashes, including protected disposable pinned systemd proc, signed chrony, PID-only udev, signed sudo and python3 preinst reference harnesses; production authorities remain typed and versioned."
      }
    ]
  },
