      "reviewed_exceptions": [
        {
          "id": "CVE-2025-26519",
          "disposition": "patched_in_toolchain",
          "rationale": "Zig 0.17.0 retains the iconv implementation from the reviewed mitigation commit 8a3aebaee0a68d037a6f311bc5c1b426e8e1884c byte-for-byte (SHA256 d04b46b1e88f70e31681c21f7208464306dd4011457bb7ec114fb97f7c44aec2). The authenticated release source archive was verified against its published SHA256."
        },
        {
          "id": "CVE-2026-40200",
          "disposition": "not_affected",
          "rationale": "Zig 0.17.0 does not contain musl src/stdlib/qsort.c and supplies qsort from lib/c/stdlib.zig using std.mem.sortUnstableContext, so the vulnerable musl smoothsort implementation is not present."
        },
        {
          "id": "CVE-2026-6042",
          "disposition": "not_linked",
          "rationale": "The affected iconv GB18030 decoder remains in the toolchain source snapshot, but debz and its pinned static libraries do not use iconv; static linking therefore excludes that object from the release executable."
        }
      ]
    }
