      "reviewed_exceptions": [
        {
          "id": "CVE-2025-26519",
          "disposition": "patched_in_toolchain",
          "rationale": "Zig commit 8a3aebaee0a68d037a6f311bc5c1b426e8e1884c applies Rich Felker's mitigation to the bundled iconv implementation and is an ancestor of the Zig 0.16.0 toolchain commit."
        },
        {
          "id": "CVE-2026-40200",
          "disposition": "not_affected",
          "rationale": "Zig 0.16.0 removes musl src/stdlib/qsort.c and supplies qsort from lib/c/stdlib.zig using std.mem.sortUnstableContext, so the vulnerable musl smoothsort implementation is not present."
        },
        {
          "id": "CVE-2026-6042",
          "disposition": "not_linked",
          "rationale": "The affected iconv GB18030 decoder remains in the toolchain source snapshot, but debz and its pinned static libraries do not use iconv; static linking therefore excludes that object from the release executable."
        }
      ]
    }
