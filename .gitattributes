# Line endings are content in this project, not formatting. debz parses OpenPGP
# cleartext signatures, deb822 documents, and dpkg status databases, where CR
# and LF are significant bytes -- one fixture is named "inrelease-lf" precisely
# because it exists to prove LF input is handled. A checkout with
# core.autocrlf=true rewrites LF to CRLF and silently changes what those tests
# assert on, so the working tree is pinned here rather than left to whatever
# each developer's global git configuration happens to be.
* text=auto eol=lf

# Fixtures and fuzz corpora are exact bytes, not text to be tidied. Never
# translate them in either direction: a fixture that arrives with different
# bytes than it was recorded with is no longer testing what it claims to.
src/fixtures/** -text
fuzz/corpus/** -text
fuzz/corpus/alternatives/** whitespace=-blank-at-eof

# dpkg terminates every status record with a blank line, including the last, so
# a faithful status fixture ends with one. That is exact database content, not
# a stray blank line to be trimmed.
src/fixtures/package-database/** whitespace=-blank-at-eof
# The authenticated script's trailing spaces and blank EOF are digest-bound bytes.
src/fixtures/ubuntu-stonking-procps-4.0.6-3ubuntu1.postinst whitespace=-blank-at-eof,-trailing-space
# The signed sudo-rs postinst's blank EOF is part of its authenticated digest.
src/fixtures/ubuntu-stonking-sudo-rs-0.2.14-1ubuntu2.postinst whitespace=-blank-at-eof

# Binary artifacts, wherever they appear.
*.deb binary
*.tar binary
*.gz  binary
*.xz  binary
*.zst binary

# JavaScript action bundles are reproducibly generated from their action sources.
actions/setup/dist/** linguist-generated=true
actions/download/dist/** linguist-generated=true
actions/install/dist/** linguist-generated=true
